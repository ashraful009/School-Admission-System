# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL database name (default: admission_db)
POSTGRES_DB=admission_db

# PostgreSQL superuser name (default: admission_user)
POSTGRES_USER=admission_user

# PostgreSQL superuser password — CHANGE THIS in any real deployment
POSTGRES_PASSWORD=admission_pass

# ── Backend ───────────────────────────────────────────────────────────────────

# ADO.NET / EF Core connection string; host must match the compose service name
ConnectionStrings__Default=Host=db;Port=5432;Database=admission_db;Username=admission_user;Password=admission_pass

# How long (in seconds) a seat hold is reserved before it expires (default: 600)
HOLD_DURATION_SECONDS=600

# Comma-separated list of allowed CORS origins for the backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────

# Base URL the browser uses to reach the backend API (no trailing slash)
API_URL=http://localhost:8080

